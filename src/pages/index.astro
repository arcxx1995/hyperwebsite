---
import Layout from '../layouts/Layout.astro';

const weeks = [
  {
    week: 'WK 01', title: 'Think Like a Builder', tag: 'Foundation',
    points: [
      'How to think in systems, not syntax',
      'Introduction to the Agentic Workflow framework',
      'Setting up your full dev environment in one session',
      'Claude Mastery 101: talking to AI like a senior engineer',
      'Project: a personal webpage, live on the internet',
    ],
  },
  {
    week: 'WK 02', title: 'The AI-First Development Mindset', tag: 'Foundation',
    points: [
      'Prompt engineering for builders, not chatbots',
      'Token efficiency, context management, and memory patterns',
      'Introduction to Claude Code and the terminal',
      'Design basics: visual hierarchy, spacing, color systems',
      "Project: your first web app — a working tool you'll actually use",
    ],
  },
  {
    week: 'WK 03', title: 'Full Agentic Stack Development', tag: 'Core Skills',
    points: [
      'What an Agentic Workflow is and why it changes everything',
      'Building with Claude Code end-to-end',
      'File systems, APIs, databases — explained for non-coders',
      'Working with open-source AI tools',
      'Project: a complete full-stack CRUD application',
    ],
  },
  {
    week: 'WK 04', title: 'Generative AI & Design Mastery', tag: 'Core Skills',
    points: [
      'Generative AI integration: images, text, voice',
      'UI/UX design with AI tools — Figma, v0, Framer',
      'Building beautiful interfaces without knowing CSS',
      'Project: a fully designed, AI-powered content tool',
    ],
  },
  {
    week: 'WK 05', title: 'Products That Make Money', tag: 'Build',
    points: [
      'SaaS architecture for non-technical builders',
      'Payment integration with Stripe — zero backend code',
      'User authentication and accounts',
      'Project: a monetizable micro-SaaS, live and accepting payments',
    ],
  },
  {
    week: 'WK 06', title: 'Automations & Agentic Systems', tag: 'Build',
    points: [
      'Marketing automation pipelines',
      'Building AI agents that work while you sleep',
      'Connecting apps, workflows, and data without code',
      'n8n, Zapier, and custom agent builds with Claude',
      'Project: a complete business automation system',
    ],
  },
  {
    week: 'WK 07', title: 'Portfolio, Brand & LinkedIn', tag: 'Ship',
    points: [
      'Building a portfolio that makes hiring managers stop scrolling',
      'Resume writing for the AI-builder era',
      'LinkedIn optimization: the exact profile structure that gets inbound',
      'Cold outreach scripts that convert for remote roles',
      'Project: complete portfolio with 4+ live products',
    ],
  },
  {
    week: 'WK 08', title: 'Land the Job or Launch the Product', tag: 'Grow',
    points: [
      'Interview prep for remote product and AI builder roles',
      'How to price and sell your skills as a freelancer',
      'Launching your product to your first 100 users',
      'Building in public and leveraging your cohort network',
      'Final Showcase: live demo to mentors and industry guests',
    ],
  },
];
---

<Layout title="Hyperspark Studio — Build AI Products. Land Remote Jobs.">

<!-- NAV -->
<header class="nav" id="nav" role="banner">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label=">hyperspark home">&gt;hyperspark</a>
    <nav class="nav-links" aria-label="Site navigation">
      <a href="#curriculum">Curriculum</a>
      <a href="#mentors">Mentors</a>
      <a href="#pricing">Pricing</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href="#pricing" class="btn btn-primary nav-cta">Apply for Cohort →</a>
  </div>
</header>

<!-- HERO -->
<section class="hero" aria-labelledby="hero-heading">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    poster="/hero-poster.svg"
    aria-hidden="true"
  >
    <source src="/hero-vid.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-badge">
        <span>Cohort 01 · Now Open</span>
        <span class="badge-seats">Only 8 Seats</span>
      </div>

      <h1 id="hero-heading">
        You've Never Written<br>
        A Single Line of Code.<br>
        <em>That's Exactly Why You're Here.</em>
      </h1>

      <p class="hero-sub">
        Hyperspark Studio turns complete beginners into AI-powered builders who ship real products, build a portfolio that commands attention, and land remote jobs that pay like senior engineers.
      </p>

      <div class="hero-ctas">
        <a href="#pricing" class="btn btn-primary btn-lg">Claim Your Seat →</a>
        <a href="#curriculum" class="btn btn-ghost btn-lg">View Curriculum</a>
      </div>

      <div class="hero-stats" role="list" aria-label="Program highlights">
        <div class="stat" role="listitem">
          <span class="stat-value">&lt; 9 Students</span>
          <span class="stat-label">Per Cohort</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat" role="listitem">
          <span class="stat-value">5× Claude Max</span>
          <span class="stat-label">Included Free</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat" role="listitem">
          <span class="stat-value">8 Weeks</span>
          <span class="stat-label">To First Product</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TOOLS MARQUEE -->
{(() => {
  const tools = [
    { name: 'Claude',      slug: 'anthropic',  color: 'ffffff' },
    { name: 'Claude Code', slug: 'anthropic',  color: 'ffffff' },
    { name: 'Cursor',      slug: 'cursor',     color: 'ffffff' },
    { name: 'v0',          slug: 'vercel',     color: 'ffffff' },
    { name: 'Bolt',        slug: 'stackblitz', color: '1269D3' },
    { name: 'Supabase',    slug: 'supabase',   color: '3FCF8E' },
    { name: 'Vercel',      slug: 'vercel',     color: 'ffffff' },
    { name: 'Stripe',      slug: 'stripe',     color: '635BFF' },
    { name: 'n8n',         slug: 'n8n',        color: 'EA4B71' },
    { name: 'Zapier',      slug: 'zapier',     color: 'FF4A00' },
    { name: 'Make',        slug: 'make',       color: '6D00CC' },
    { name: 'Figma',       slug: 'figma',      color: 'F24E1E' },
    { name: 'Framer',      slug: 'framer',     color: '0055FF' },
    { name: 'GitHub',      slug: 'github',     color: 'ffffff' },
    { name: 'Railway',     slug: 'railway',    color: 'ffffff' },
    { name: 'Notion',      slug: 'notion',     color: 'ffffff' },
    { name: 'Linear',      slug: 'linear',     color: '5E6AD2' },
    { name: 'Webflow',     slug: 'webflow',    color: '146EF5' },
  ];
  return (
    <div class="marquee-section">
      <p class="marquee-label">Tools You Will Learn</p>
      <div class="marquee" aria-hidden="true">
        <ul class="marquee-track">
          {[...tools, ...tools].map((t, i) => (
            <li class="marquee-item marquee-item--logo-only" key={i}>
              <img
                src={`https://cdn.simpleicons.org/${t.slug}/${t.color}`}
                alt={t.name}
                width="24"
                height="24"
                class="marquee-logo marquee-logo--brand"
              />
              <span class="marquee-item-name">{t.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  );
})()}

<!-- MONOLOGUE -->
<section class="monologue-section">
  <div class="container">
    <p class="monologue-text" data-reveal>
      Every tool in that row is built to let non-engineers ship production software.<br>
      The companies below are actively hiring people who know how to use them.<br>
      <em>In eight weeks, you will.</em>
    </p>
  </div>
</section>

<!-- COMPANIES MARQUEE -->
{(() => {
  const companies = [
    { name: 'Shopify',     slug: 'shopify',     color: '96BF48' },
    { name: 'GitLab',      slug: 'gitlab',      color: 'FC6D26' },
    { name: 'Automattic',  slug: 'automattic',  color: '3499CD' },
    { name: 'Toptal',      slug: 'toptal',      color: '3863A0' },
    { name: 'Buffer',      slug: 'buffer',      color: 'ffffff' },
    { name: 'Webflow',     slug: 'webflow',     color: '146EF5' },
    { name: 'HubSpot',     slug: 'hubspot',     color: 'FF7A59' },
    { name: 'Loom',        slug: 'loom',        color: '625DF5' },
    { name: 'Miro',        slug: 'miro',        color: 'FFD02F' },
    { name: 'Atlassian',   slug: 'atlassian',   color: '0052CC' },
    { name: 'Canva',       slug: 'canva',       color: '00C4CC' },
    { name: 'Zapier',      slug: 'zapier',      color: 'FF4A00' },
    { name: 'Stripe',      slug: 'stripe',      color: '635BFF' },
    { name: 'Linear',      slug: 'linear',      color: '5E6AD2' },
    { name: 'Figma',       slug: 'figma',       color: 'F24E1E' },
    { name: 'Todoist',     slug: 'todoist',     color: 'DB4035' },
