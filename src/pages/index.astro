  return (
    <div class="marquee-section marquee-section--companies">
      <p class="marquee-label">Where Our Students Work</p>
      <div class="marquee" aria-hidden="true">
        <ul class="marquee-track marquee-track--reverse">
          {[...companies, ...companies].map((c, i) => (
            <li class="marquee-item marquee-item--logo-only" key={i}>
              <img
