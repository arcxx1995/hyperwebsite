<!-- HERO -->
<section class="hero" aria-labelledby="hero-heading">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    poster="/hero-poster.svg"
    aria-hidden="true"
  >
    <source src="/hero-vid.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-badge">
        <span>Development Studio for Founders</span>
        <span class="badge-seats">MVP to Scale</span>
      </div>

      <h1 id="hero-heading">
        Founders Don't Need&nbsp;<br>
        Advice. They Need It&nbsp;<br>
        <em>Shipped.</em>
      </h1>

      <p class="hero-sub">
        Hyperspark Studio builds websites, iOS and Android apps, native web apps, and AI-native products — senior engineers who own the build end to end, not a junior bench you have to manage yourself.
      </p>

      <div class="hero-ctas">
        <a href="/start" class="btn btn-primary btn-lg">Discuss Your MVP →</a>
        <a href="#projects" class="btn btn-ghost btn-lg">View Project Types</a>
      </div>

      <div class="hero-stats" role="list" aria-label="Studio highlights">
        <div class="stat" role="listitem">
          <span class="stat-value">3Mn+</span>
          <span class="stat-label">Users Reached</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat" role="listitem">
          <span class="stat-value">10Mn+</span>
          <span class="stat-label">Revenue Generated</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat" role="listitem">
          <span class="stat-value">26+</span>
          <span class="stat-label">Apps Worked On</span>
        </div>
      </div>
    </div>
  </div>
</section>

