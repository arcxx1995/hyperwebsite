---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'What do you build?',
    a: 'We build startup MVPs, premium websites, SaaS products, native web apps, iOS and Android apps, internal tools, and AI or LLM-integrated products.',
  },
  {
    q: 'Can you work with non-technical founders?',
    a: 'Yes. Many founders come to us with a strong product idea but no engineering team. We help shape the scope, explain tradeoffs, and turn the idea into software users can actually use.',
  },
  {
    q: 'Can you handle large projects?',
    a: 'Yes. We can take on larger product builds with multiple surfaces, integrations, admin systems, mobile apps, AI workflows, and phased releases. We scope them in milestones so progress stays visible.',
  },
  {
    q: 'Do you only build AI apps?',
    a: 'No. We build conventional software and AI-native products. If AI creates leverage, we integrate it. If a clean app, website, or backend system is the better answer, we build that.',
  },
  {
    q: 'What stage should we be at before reaching out?',
    a: 'Reach out when you have a product direction, target user, or business problem worth building around. A rough brief is enough if you are ready to make decisions and move quickly.',
  },
  {
    q: 'Do you stay involved after launch?',
    a: 'We can. Many products need iteration once real users arrive, so we can support v2 features, bug fixes, analytics, performance, AI improvements, and ongoing engineering velocity.',
  },
  {
    q: 'Can you build the website too?',
    a: 'Yes. We build launch pages, product sites, waitlists, landing pages, CMS-backed websites, and founder brands. The website can be part of the product launch, not a separate afterthought.',
  },
  {
    q: 'How do we start?',
    a: 'Send us a short product brief with the problem, target users, current stage, desired launch timeline, and what you need built. We will respond with the best next step.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const weeks = [
  {
    week: 'PH 01', title: 'Founder Brief', tag: 'Discovery',
    points: [
      'Clarify the product thesis, market, users, and launch constraints',
      'Separate must-have MVP scope from expensive distractions',
      'Map the technical risks before a sprint starts',
      'Define the first usable version your customers can touch',
    ],
  },
  {
    week: 'PH 02', title: 'Product Architecture', tag: 'Planning',
    points: [
      'Choose the right stack for speed today and scale tomorrow',
      'Plan data models, APIs, authentication, payments, and deployment',
      'Design the handoff between web, mobile, and AI systems',
      'Build a delivery roadmap with clear weekly milestones',
    ],
  },
  {
    week: 'PH 03', title: 'Interface System', tag: 'Design',
    points: [
      'Shape the product experience around your first real workflows',
      'Create a design system that makes the MVP feel funded',
      'Prototype key screens for web, iOS, Android, and admin surfaces',
      'Stress-test the UX before engineering time is spent',
    ],
  },
  {
    week: 'PH 04', title: 'Core Build Sprint', tag: 'Engineering',
    points: [
      'Ship the web app, native app, dashboard, or marketplace core',
      'Implement auth, databases, subscriptions, notifications, and analytics',
      'Keep founders close to weekly demos and decision points',
      'Maintain a production-grade codebase from the first commit',
    ],
  },
  {
    week: 'PH 05', title: 'AI & LLM Integration', tag: 'Intelligence',
    points: [
      'Add LLM workflows where they create real product leverage',
      'Build chat, copilots, document intelligence, agents, and automations',
      'Connect model outputs to product state, permissions, and audit trails',
      'Evaluate latency, cost, reliability, and safety before launch',
    ],
  },
  {
    week: 'PH 06', title: 'QA, Analytics & Hardening', tag: 'Reliability',
    points: [
      'Test the critical user paths across devices and roles',
      'Instrument product analytics, event tracking, and error visibility',
      'Review security, permissions, rate limits, and payment edge cases',
      'Prepare the release branch, rollback plan, and launch checklist',
    ],
  },
  {
    week: 'PH 07', title: 'Launch Support', tag: 'Release',
    points: [
      'Deploy the product to production with a clean launch path',
      'Support App Store, Play Store, Vercel, cloud, and domain setup',
      'Create the website, onboarding, emails, and operational flows',
      'Stay close during the first user wave and fix what reality reveals',
    ],
  },
  {
    week: 'PH 08', title: 'Founder Engineering Team', tag: 'Scale',
    points: [
      'Iterate on customer feedback after the MVP is live',
      'Plan v2 features, integrations, and growth experiments',
      'Handle ongoing engineering velocity without hiring too early',
      'Become the technical team founders can keep building with',
    ],
  },
];
---

<Layout
  title="Software Development Company for Founders | Hyperspark Studio"
  description="Hyperspark Studio is a software development company for founders. Custom software development: MVPs, websites, iOS and Android apps, and AI-native products — built by senior engineers."
>

<script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

<!-- NAV -->
<header class="nav" id="nav" role="banner">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label=">hyperspark home">&gt;hyperspark</a>
    <nav class="nav-links" aria-label="Site navigation">
      <a href="#services">Services</a>
      <a href="#projects">Projects</a>
      <a href="#journey-pin">Process</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href="/start" class="btn btn-primary nav-cta">Start a Build →</a>
