<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion) gsap.defaults({ duration: 0.01 });

  // ── HERO VIDEO ──
  const heroVideo = document.querySelector('.hero-video') as HTMLVideoElement | null;
  if (heroVideo && reducedMotion) {
    heroVideo.pause();
    heroVideo.removeAttribute('autoplay');
  }

  // ── NAV SCROLL ──
  const nav = document.getElementById('nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });
  }

  // ── HERO ENTRANCE ──
  const heroTl = gsap.timeline({ delay: 0.1 });
  heroTl
    .from('.hero-badge',  { y: -14, opacity: 0, duration: 0.6, ease: 'power3.out' })
    .from('.hero h1',     { y: 32,  opacity: 0, duration: 0.9, ease: 'power4.out' }, '-=0.35')
    .from('.hero-sub',    { y: 20,  opacity: 0, duration: 0.8, ease: 'power3.out' }, '-=0.45')
    .from('.hero-ctas',   { y: 16,  opacity: 0, duration: 0.7, ease: 'power3.out' }, '-=0.4')
    .from('.hero-stats > *', { opacity: 0, y: 8, duration: 0.5, stagger: 0.09, ease: 'power2.out' }, '-=0.3');

  // ── HERO PARALLAX ──
  gsap.to('.hero-content', {
    y: -70,
    ease: 'none',
    scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1.2 }
  });

  // ── SECTION HEADERS ──
  gsap.utils.toArray<HTMLElement>('.section-header').forEach(el => {
    gsap.from(el.children, {
      y: 28, opacity: 0, stagger: 0.12, duration: 0.75, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 84%' }
    });
  });

  // ── MARQUEE SECTIONS ──
  gsap.utils.toArray<HTMLElement>('.marquee-section').forEach(el => {
    gsap.from(el, {
      opacity: 0, duration: 0.8, ease: 'power2.out',
      scrollTrigger: { trigger: el, start: 'top 92%' }
    });
  });

  // ── MONOLOGUE ──
  gsap.from('.monologue-text', {
    y: 40, opacity: 0, duration: 1.1, ease: 'power4.out',
    scrollTrigger: { trigger: '.monologue-text', start: 'top 82%' }
  });

  // ── PROBLEM (HONEST TRUTH) ──
  gsap.from('.honest-heading', {
    y: 32, opacity: 0, duration: 0.9, ease: 'power4.out',
    scrollTrigger: { trigger: '.section-honest', start: 'top 80%' }
  });
  gsap.from('.honest-stat', {
    y: 24, opacity: 0, stagger: 0.12, duration: 0.7, ease: 'power3.out',
    scrollTrigger: { trigger: '.honest-stats', start: 'top 84%' }
  });
  gsap.from('.honest-num', {
    y: 12, opacity: 0, duration: 0.7, stagger: 0.08, ease: 'power2.out',
    scrollTrigger: { trigger: '.honest-stats', start: 'top 84%' }
  });
  gsap.from('.honest-quote', {
    y: 30, opacity: 0, duration: 1, ease: 'power4.out',
    scrollTrigger: { trigger: '.honest-quote-wrap', start: 'top 82%' }
  });
  gsap.utils.toArray<HTMLElement>('.reality-row').forEach((row) => {
    const tl = gsap.timeline({
      scrollTrigger: { trigger: row, start: 'top 84%' }
    });
    tl
      .from(row.querySelector('.reality-meta'), {
        y: -8, opacity: 0, duration: 0.4, ease: 'power2.out'
      })
      .from(row.querySelector('.reality-heading'), {
        y: 36, opacity: 0, duration: 0.8, ease: 'power4.out'
      }, '-=0.15')
      .from(row.querySelector('.reality-body'), {
        y: 16, opacity: 0, duration: 0.6, ease: 'power3.out'
      }, '-=0.5');
  });

  // ── AUDIENCE: PINNED SCROLL WITH PARALLAX ──
  const aSlides  = gsap.utils.toArray<HTMLElement>('.audience-slide');
  const aFill    = document.getElementById('audience-fill');
  const aPin     = document.getElementById('audience-pin');
  const aAudCur  = document.querySelector<HTMLElement>('.aud-cur');

  if (aSlides.length && aPin && !reducedMotion) {
    const N    = aSlides.length;
    const STEP = 4; // timeline units per slide transition

    // Initial state: all hidden, first visible
    gsap.set(aSlides, { autoAlpha: 0 });
    gsap.set(aSlides[0], { autoAlpha: 1 });

    // Pre-position all incoming slides off-screen right
    aSlides.forEach((slide, i) => {
      if (i === 0) return;
      const box  = slide.querySelector<HTMLElement>('.audience-img-box');
      const text = slide.querySelector<HTMLElement>('.audience-text');
      gsap.set(box,  { xPercent: 18 });
      gsap.set(text, { xPercent: 10, autoAlpha: 0 });
    });

    // First slide: pre-position image for drift
    const firstImg = aSlides[0].querySelector<HTMLElement>('.audience-img-box img');
    if (firstImg) gsap.set(firstImg, { yPercent: 10 });

    const aTl = gsap.timeline({
      scrollTrigger: {
        trigger: aPin,
        start: 'top top',
        end: () => `+=${(N - 1) * window.innerHeight}`,
        pin: true,
        pinSpacing: true,
        scrub: 1.5,
        onUpdate(self) {
          if (aFill) gsap.set(aFill, { scaleX: self.progress });
          if (aAudCur) {
            const idx = Math.min(N - 1, Math.floor(self.progress * N + 0.08));
            aAudCur.textContent = String(idx + 1).padStart(2, '0');
          }
        }
      }
    });

    // Slide 0: image drifts through its whole time window
    if (firstImg) {
      aTl.to(firstImg, { yPercent: -10, ease: 'none', duration: STEP }, 0);
    }

    aSlides.forEach((slide, i) => {
      if (i === 0) return;

      const t       = (i - 1) * STEP;       // when this transition starts
      const tEnter  = t + STEP * 0.45;       // when new slide starts entering

      const prev     = aSlides[i - 1];
      const prevBox  = prev.querySelector<HTMLElement>('.audience-img-box');
      const prevImg  = prev.querySelector<HTMLElement>('.audience-img-box img');
      const prevText = prev.querySelector<HTMLElement>('.audience-text');

      const box  = slide.querySelector<HTMLElement>('.audience-img-box');
      const img  = slide.querySelector<HTMLElement>('.audience-img-box img');
      const text = slide.querySelector<HTMLElement>('.audience-text');

      aTl
        // ── EXIT: prev text fades + moves left ──
        .to(prevText, {
          xPercent: -12, autoAlpha: 0,
          duration: STEP * 0.5, ease: 'power2.inOut'
        }, t)
        // ── EXIT: prev image box slides left, image keeps drifting ──
        .to(prevBox, {
          xPercent: -8, autoAlpha: 0,
          duration: STEP * 0.5, ease: 'power2.inOut'
        }, t)
        // prev image drifts upward on exit (continues its parallax)
        .to(prevImg, {
          yPercent: -18, ease: 'none',
          duration: STEP * 0.5
        }, t)

        // hide prev slide wrapper cleanly
        .set(prev, { autoAlpha: 0 }, t + STEP * 0.5)

        // ── ENTER: show new slide ──
        .set(slide, { autoAlpha: 1 }, tEnter)

        // image box slides in from right
        .to(box, {
          xPercent: 0, autoAlpha: 1,
          duration: STEP * 0.6, ease: 'power3.out'
        }, tEnter)

        // text follows slightly behind (speed contrast = parallax feel)
        .to(text, {
          xPercent: 0, autoAlpha: 1,
          duration: STEP * 0.55, ease: 'power3.out'
        }, tEnter + STEP * 0.1)

        // ── PARALLAX: image drifts upward inside box while slide is live ──
        .fromTo(img,
          { yPercent: 12 },
          { yPercent: -12, ease: 'none', duration: STEP * 0.9 },
          tEnter
        );
    });
  }

  // ── BUILD GRID ──
  ScrollTrigger.batch('.build-item', {
    onEnter: batch => gsap.from(batch, { y: 20, opacity: 0, stagger: 0.05, duration: 0.5, ease: 'power2.out' }),
    start: 'top 88%'
  });

  // ── JOURNEY MAP (Process) ──
  const journeyPin   = document.querySelector<HTMLElement>('#journey-pin');
  const jCards       = gsap.utils.toArray<HTMLElement>('.journey-card');
  const jNodes       = gsap.utils.toArray<HTMLElement>('.journey-node-dot');
  const jNodeWraps   = gsap.utils.toArray<HTMLElement>('.journey-node');
  const jPathFill    = document.querySelector<HTMLElement>('.journey-path-fill');
  const jCur         = document.querySelector<HTMLElement>('.journey-cur');
  const N_J          = jCards.length;
  const J_STEP       = 4;

  if (journeyPin && jCards.length) {
    gsap.set(jCards, { autoAlpha: 0, y: 55 });
    gsap.set(jCards[0], { autoAlpha: 1, y: 0 });
    // Activate first node immediately
    jNodes[0]?.classList.add('is-active', 'is-current');
    jNodeWraps[0]?.classList.add('is-cur');

    const jTl = gsap.timeline({
      scrollTrigger: {
        trigger: journeyPin,
        start: 'top top',
        end: () => `+=${(N_J - 1) * window.innerHeight}`,
        pin: true,
        pinSpacing: true,
        scrub: 1.5,
        onUpdate(self) {
          if (jPathFill) gsap.set(jPathFill, { scaleX: self.progress });
          const activeIdx = Math.min(N_J - 1, Math.floor(self.progress * N_J + 0.08));
          if (jCur) jCur.textContent = String(activeIdx + 1).padStart(2, '0');
          // Class-based dot state (CSS handles pulse + color)
          jNodes.forEach((dot, i) => {
            dot.classList.toggle('is-active', i <= activeIdx);
            dot.classList.toggle('is-current', i === activeIdx);
          });
          jNodeWraps.forEach((wrap, i) => {
            wrap.classList.toggle('is-cur', i === activeIdx);
          });
        },
      },
    });

    // Per-card transitions
    jCards.forEach((card, i) => {
      if (i === 0) return;
      const t = (i - 1) * J_STEP;
      jTl.to(jCards[i - 1], { autoAlpha: 0, y: -35, duration: 1.2, ease: 'power2.in' }, t);
      jTl.to(card, { autoAlpha: 1, y: 0, duration: 1.8, ease: 'power3.out' }, t + 0.7);
    });
  }

  // ── INCLUDES ──
  ScrollTrigger.batch('.include-tile', {
    onEnter: batch => gsap.from(batch, { y: 24, opacity: 0, stagger: 0.07, duration: 0.6, ease: 'power3.out' }),
    start: 'top 88%'
  });

  // ── TEAM ──
  gsap.from('.mentor-card', {
    y: 32, opacity: 0, stagger: 0.14, duration: 0.75, ease: 'power3.out',
    scrollTrigger: { trigger: '.mentors-grid', start: 'top 82%' }
  });

  // ── TESTIMONIALS ──
  gsap.from('.testimonial-card', {
    y: 32, opacity: 0, stagger: 0.14, duration: 0.75, ease: 'power3.out',
    scrollTrigger: { trigger: '.testimonials-grid', start: 'top 82%' }
  });

  // ── ENGAGEMENT ──
  gsap.from('.pricing-card', {
    y: 40, opacity: 0, scale: 0.97, duration: 0.9, ease: 'power4.out',
    scrollTrigger: { trigger: '.pricing-card', start: 'top 84%' }
  });

  // ── FAQ ──
  gsap.from('.faq-item', {
    y: 14, opacity: 0, stagger: 0.04, duration: 0.5, ease: 'power2.out',
    scrollTrigger: { trigger: '.faq-list', start: 'top 84%' }
  });

  // ── FINAL CTA ──
  gsap.from('.final-cta h2, .final-cta > .container > p, .final-cta .btn', {
    y: 20, opacity: 0, stagger: 0.12, duration: 0.75, ease: 'power3.out',
    scrollTrigger: { trigger: '.final-cta', start: 'top 82%' }
  });
</script>
