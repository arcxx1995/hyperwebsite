<!-- PROBLEM: THE HONEST TRUTH -->
<section class="section-honest" aria-labelledby="problem-heading">

  <!-- Heading block with image bg -->
  <div class="honest-hero">
    <img src="/hero-bg.png" alt="" class="honest-hero-img" aria-hidden="true">
    <div class="container honest-hero-content">
      <h2 id="problem-heading" class="honest-heading">The World Changed.<br>Nobody Told You.</h2>
    </div>
  </div>

  <!-- Stats, quote, realities -->
  <div class="container honest-content">

    <!-- Big stats strip -->
    <div class="honest-stats">
      <div class="honest-stat">
        <span class="honest-num">97M</span>
        <span class="honest-stat-desc">New AI-related roles projected globally by 2025 — World Economic Forum</span>
      </div>
      <div class="honest-stat-rule" aria-hidden="true"></div>
      <div class="honest-stat">
        <span class="honest-num">€4.5K</span>
        <span class="honest-stat-desc">Average monthly salary for remote AI builder roles — no CS degree required</span>
      </div>
      <div class="honest-stat-rule" aria-hidden="true"></div>
      <div class="honest-stat">
        <span class="honest-num">48 hrs</span>
        <span class="honest-stat-desc">Average time to ship a working SaaS MVP using Claude Code, start to deployed</span>
      </div>
    </div>

    <!-- Pull quote -->
    <div class="honest-quote-wrap">
      <blockquote class="honest-quote">
        A 22-year-old with Claude and a weekend just shipped the product your company has been planning for two years.
      </blockquote>
    </div>

    <!-- 3 realities — no card borders -->
    <div class="honest-realities">
      {[
        {
          idx: '01', cat: 'Disruption',
          heading: 'The Old\nRésumé Is Dead.',
          body: 'Hiring managers now look for shipped products, not degrees. A portfolio of live AI tools gets you in the room a CS degree never would.'
        },
        {
          idx: '02', cat: 'Opportunity',
          heading: 'Remote Jobs Pay\nGlobal. Cost Local.',
          body: 'A €4,500/month remote role changes everything when you live in Bangalore, Bali, or Baroda. The opportunity is real. The skillset is learnable.'
        },
        {
          idx: '03', cat: 'Access',
          heading: 'The Barrier Is\nAccess. Not Ability.',
          body: 'You just never had someone to show you the right way to build. Eight weeks from now, you will have the portfolio to prove it.'
        },
      ].map((r) => (
        <div class="reality-row">
          <div class="reality-meta">
            <span class="reality-idx">{r.idx}</span>
            <span class="reality-cat">{r.cat}</span>
          </div>
          <div class="reality-content">
            <h3 class="reality-heading">
              {r.heading.split('\n').map((line, i, arr) => (
                <>{line}{i < arr.length - 1 && <br/>}</>
              ))}
            </h3>
            <p class="reality-body">{r.body}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- AUDIENCE: WHO THIS IS FOR -->
<section class="audience-section" aria-labelledby="audience-heading">
  <div class="audience-pin" id="audience-pin">

    <!-- Left: permanently positioned heading column (absolute, no grid/flex parent) -->
    <div class="audience-heading-col">
      <h2 id="audience-heading">Built For<br>The Person<br>Who Has Never<br>Written<br>Hello World.</h2>
      <div class="audience-slide-counter"><span class="aud-cur">01</span> / 06</div>
    </div>

    <!-- Right: absolutely positioned slides stage -->
    <div class="audience-stage">
    {[
      {
        num: '01', title: 'The Marketer',
        voice: '"I have ideas but I depend on developers to build them."',
        help: 'You stop depending on dev teams. Build landing pages, automate campaigns, and ship ideas the same week you have them.',
        img: 'https://picsum.photos/seed/hs-marketer/720/900'
      },
      {
        num: '02', title: 'The Non-Technical Founder',
        voice: '"I have a startup idea but no co-founder and no budget."',
        help: 'You become your own CTO. Ship your MVP in Week 5, iterate on real user feedback, and raise your first round with a live product in hand.',
        img: 'https://picsum.photos/seed/hs-founder/720/900'
      },
      {
        num: '03', title: 'The Career Switcher',
        voice: '"I want to break into tech without a 4-year degree."',
        help: 'You build 4 portfolio products, rewrite your LinkedIn from scratch, and get warm intros to remote hiring partners in Week 7.',
        img: 'https://picsum.photos/seed/hs-career/720/900'
      },
      {
        num: '04', title: 'The Freelancer',
        voice: '"I want to offer AI product-building as a service."',
        help: 'You add AI product-building to your service list. Charge 3 times more. Build client tools in days. Deliver what agencies quote months for.',
        img: 'https://picsum.photos/seed/hs-freelance/720/900'
      },
      {
        num: '05', title: 'The Business Analyst',
        voice: '"I want to automate everything I do manually."',
        help: 'You automate your workflows in Week 6. Build internal tools your team actually uses. Stop waiting on dev resources for every small request.',
        img: 'https://picsum.photos/seed/hs-analyst/720/900'
      },
      {
        num: '06', title: 'The Dreamer',
        voice: '"I just want to build something I\'m genuinely proud of."',
        help: 'You ship the thing you\'ve been talking about for years. Live URL. Real users. Your name on it.',
        img: 'https://picsum.photos/seed/hs-dreamer/720/900'
      },
    ].map((p, i) => (
      <div class="audience-slide" data-slide={i}>
        <div class="container audience-slide-inner">
          <div class="audience-text">
            <span class="slide-num">{p.num} / 06</span>
            <h3 class="slide-title">{p.title}</h3>
            <p class="slide-voice">{p.voice}</p>
            <div class="slide-help">
              <span class="slide-help-label">With Hyperspark</span>
              <p class="slide-help-body">{p.help}</p>
            </div>
          </div>
          <div class="audience-media">
            <div class="audience-img-box">
              <img
                src={p.img}
                alt={p.title}
                width="720"
                height="900"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    ))}

    </div><!-- /audience-stage -->

    <div class="audience-progress-track" aria-hidden="true">
      <div class="audience-progress-fill" id="audience-fill"></div>
    </div>
  </div>
</section>

<!-- WHAT YOU'LL BUILD -->
<section class="build-section" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <h2 id="build-heading">Not a Certificate.<br>A Portfolio of Real Things.</h2>
      <p>By the time you graduate, you'll have shipped products people can actually use.</p>
    </div>
    <div class="build-grid">
      {[
        { num: '01', title: 'Web Applications', desc: 'Full-stack apps real users can interact with' },
        { num: '02', title: 'SaaS Products', desc: 'Subscription tools that generate recurring revenue' },
        { num: '03', title: 'Mobile-Ready Sites', desc: 'For clients or your own brand, on every device' },
        { num: '04', title: 'Automations', desc: 'Business workflows that run without you' },
        { num: '05', title: 'AI Agents', desc: 'Agentic systems built with Claude' },
        { num: '06', title: 'Browser Games', desc: 'Fully playable, shareable, yours' },
        { num: '07', title: 'Marketing Funnels', desc: 'Landing pages that convert, not just look good' },
        { num: '08', title: 'Your Startup MVP', desc: 'The idea you\'ve had for two years, finally shipped' },
      ].map((item, i) => (
        <div class="build-item" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <span class="build-num" aria-hidden="true">{item.num}</span>
          <div>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CURRICULUM / JOURNEY MAP -->
<section id="journey-pin" aria-labelledby="journey-heading">
  <div class="journey-inner">

    <!-- Left: permanent heading -->
    <div class="journey-left">
      <h2 id="journey-heading">8<br>Weeks.</h2>
      <p class="journey-sub">From Zero<br>to Shipped.</p>
      <div class="journey-counter" aria-live="polite">
        <span class="journey-cur">01</span><span class="journey-sep"> / 08</span>
      </div>
    </div>

    <!-- Right: scrolling content + map -->
    <div class="journey-right">
      <div class="journey-stage">
        {weeks.map((w, i) => (
          <div class="journey-card" data-card={i} aria-hidden={i !== 0 ? 'true' : 'false'}>
            <div class="journey-card-meta">
              <span class="journey-card-wk">{w.week}</span>
              <span class="journey-card-phase">{w.tag}</span>
            </div>
            <h3 class="journey-card-title">{w.title}</h3>
            <ul class="journey-card-points">
              {w.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <nav class="journey-map" aria-label="Course weeks">
        <div class="journey-path" aria-hidden="true">
          <div class="journey-path-fill"></div>
        </div>
        {weeks.map((w, i) => (
          <div class="journey-node" data-node={i}>
            <div class="journey-node-dot" aria-hidden="true"></div>
            <span class="journey-node-label">{String(i + 1).padStart(2, '0')}</span>
          </div>
        ))}
      </nav>
    </div>

  </div>
</section>

<!-- WHAT'S INCLUDED -->
