---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Start a Build — Hyperspark Studio"
  description="Send Hyperspark Studio your product brief. Five questions, no mailer, straight to the team."
>

<section class="brief-page">
  <div class="container brief-container">
    <a href="/" class="brief-logo" aria-label="Hyperspark home">&gt;hyperspark</a>

    <div class="brief-head">
      <h1>Send Your<br>Product Brief.</h1>
      <p>Five questions. That is all we need to tell you if we are the right fit.</p>
    </div>

    <form
      action="https://formspree.io/f/xgojpwnq"
      method="POST"
      class="brief-form"
    >
      <input type="hidden" name="_next" value="/thank-you" />
      <input type="hidden" name="_subject" value="New founder brief — Hyperspark" />
      <p class="brief-honeypot">
        <label>Don't fill this out: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="brief-field">
        <label for="name">01 · Your name</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="brief-field">
        <label for="email">02 · Your email</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div class="brief-field">
        <label for="building">03 · What are you building?</label>
        <select id="building" name="building" required>
          <option value="" disabled selected>Select one</option>
          <option>Website</option>
          <option>MVP</option>
          <option>iOS or Android App</option>
          <option>SaaS Platform</option>
          <option>AI or LLM Product</option>
          <option>Something else</option>
        </select>
      </div>

      <div class="brief-field">
        <label for="stage">04 · What stage are you at?</label>
        <select id="stage" name="stage" required>
          <option value="" disabled selected>Select one</option>
          <option>Just an idea</option>
          <option>Early product, no users yet</option>
          <option>Live product, need to scale</option>
        </select>
      </div>

      <div class="brief-field">
        <label for="timeline">05 · What is your timeline?</label>
        <select id="timeline" name="timeline" required>
          <option value="" disabled selected>Select one</option>
          <option>ASAP</option>
          <option>1–3 months</option>
          <option>3–6 months</option>
          <option>Not sure yet</option>
        </select>
      </div>

      <div class="brief-field">
        <label for="whatsapp">06 · WhatsApp no.</label>
        <input type="tel" id="whatsapp" name="whatsapp" placeholder="+1 555 123 4567" />
      </div>

      <button type="submit" class="btn btn-primary btn-lg btn-full">Send Brief →</button>
    </form>
  </div>
</section>

</Layout>
