---
import Layout from '../layouts/Layout.astro';

interface Faq {
  q: string;
  a: string;
}

interface Benefit {
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  badge: string;
  heading: string;
  sub: string;
  definitionHeading: string;
  definition: string[];
  servicesHeading: string;
  services: string[];
  benefitsHeading: string;
  benefits: Benefit[];
  faqs: Faq[];
  pageName: string;
}

const {
  title, description, badge, heading, sub,
  definitionHeading, definition,
  servicesHeading, services,
  benefitsHeading, benefits,
  faqs, pageName,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: title,
      description,
      isPartOf: { '@id': 'https://hyperspark.studio/#website' },
      about: { '@id': 'https://hyperspark.studio/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hyperspark.studio/' },
        { '@type': 'ListItem', position: 2, name: pageName, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Layout title={title} description={description}>

<script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

<header class="nav" role="banner">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label=">hyperspark home">&gt;hyperspark</a>
    <nav class="nav-links" aria-label="Site navigation">
      <a href="/#services">Services</a>
      <a href="/#projects">Projects</a>
      <a href="/#journey-pin">Process</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <a href="/start" class="btn btn-primary nav-cta">Start a Build →</a>
  </div>
</header>

<main>
  <section class="landing-hero" aria-labelledby="landing-heading">
    <div class="container">
      <div class="hero-badge"><span>{badge}</span></div>
      <h1 id="landing-heading" set:html={heading} />
      <p class="hero-sub">{sub}</p>
      <div class="hero-ctas">
        <a href="/start" class="btn btn-primary btn-lg">Send Your Product Brief →</a>
        <a href="/#projects" class="btn btn-ghost btn-lg">See Our Work</a>
      </div>
    </div>
  </section>

  <section class="section-surface" aria-labelledby="definition-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="definition-heading">{definitionHeading}</h2>
      </div>
      <div class="landing-prose">
        {definition.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section-surface" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="services-heading">{servicesHeading}</h2>
      </div>
      <ul class="pricing-includes landing-services">
        {services.map((s) => (
          <li>
            <svg class="check" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
            {s}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-surface" aria-labelledby="benefits-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="benefits-heading">{benefitsHeading}</h2>
      </div>
      <div class="build-grid">
        {benefits.map((b, i) => (
          <div class="build-item">
            <span class="build-num">{String(i + 1).padStart(2, '0')}</span>
            <h4>{b.title}</h4>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-surface" aria-labelledby="landing-faq-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="landing-faq-heading">Frequently Asked Questions</h2>
      </div>
      <dl class="faq-list">
        {faqs.map((item) => (
          <div class="faq-item">
            <details>
              <summary>
                {item.q}
                <svg class="faq-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
              </summary>
              <div class="faq-body"><p>{item.a}</p></div>
            </details>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section-violet final-cta" aria-labelledby="landing-cta-heading">
    <div class="container">
      <h2 id="landing-cta-heading">Ready When The<br>Build Matters.</h2>
      <p>Send a short product brief. We will tell you honestly if we are the right team, and what the fastest path to shipped looks like.</p>
      <a href="/start" class="btn btn-primary btn-lg">Start a Build →</a>
    </div>
  </section>
</main>

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="nav-logo">&gt;hyperspark</a>
        <p>Development studio for founders building MVPs, apps, websites, and AI-native products.</p>
      </div>
      <div class="footer-col">
        <h5>Studio</h5>
        <ul>
          <li><a href="/#services">Services</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h5>Build</h5>
        <ul>
          <li><a href="/vibe-coding-agency">Vibe Coding Agency</a></li>
          <li><a href="/cto-for-hire">CTO for Hire</a></li>
          <li><a href="/build-mvp">MVP Development</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h5>Contact</h5>
        <ul>
          <li><a href="mailto:build@hyperspark.studio">build@hyperspark.studio</a></li>
          <li><a href="https://twitter.com/hypersparkstudio" rel="noopener noreferrer" target="_blank">Twitter / X</a></li>
          <li><a href="https://linkedin.com/company/hyperspark-studio" rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Hyperspark Studio. All rights reserved.</p>
      <p>Built by Hyperspark.</p>
    </div>
  </div>
</footer>

</Layout>
