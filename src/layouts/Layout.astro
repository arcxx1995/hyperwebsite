---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Hyperspark Studio is a development studio for founders building MVPs, websites, mobile apps, native web apps, and AI-native products.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://hyperspark.studio/#organization',
      name: 'Hyperspark Studio',
      alternateName: 'Hyperspark',
      url: 'https://hyperspark.studio',
      email: 'build@hyperspark.studio',
      description:
        'Hyperspark Studio builds websites, iOS and Android apps, native web apps, and AI-native products for founders: senior engineers who own the build end to end.',
      areaServed: ['US', 'EU'],
      sameAs: [
        'https://twitter.com/hypersparkstudio',
        'https://linkedin.com/company/hyperspark-studio',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://hyperspark.studio/#website',
      url: 'https://hyperspark.studio',
      name: 'Hyperspark Studio',
      publisher: { '@id': 'https://hyperspark.studio/#organization' },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="facebook-domain-verification" content="t2auzfr8ga9hf5bb70nz4hykbarcrt" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="en-us" href={canonical} />
    <link rel="alternate" hreflang="en-gb" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hyperspark Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- REPLACE_WITH_GSC_TOKEN: uncomment and paste your Search Console token -->
    <!-- <meta name="google-site-verification" content="PASTE_TOKEN_HERE" /> -->
    <meta name="theme-color" content="#130b22" />
    <link rel="preload" href="/fonts/GeistPixel-Square.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
