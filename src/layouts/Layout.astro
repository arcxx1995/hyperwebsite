---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Hyperspark Studio is a development studio for founders building MVPs, websites, mobile apps, native web apps, and AI-native products.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#130b22" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
